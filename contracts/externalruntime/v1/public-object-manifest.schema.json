{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bindery.dev/contracts/externalruntime/v1/public-object-manifest.schema.json",
  "title": "Bindery public capture object manifest",
  "description": "A heavy capture artifact -- post-match dump, replay, crash bundle -- described without describing where it is stored. Content addressing removes the need for a second private identifier, so there is none to leak.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_hash", "media_type", "bytes", "capture_id", "producer_client_id", "capture_method", "received_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "media_type": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9][a-z0-9.+-]{0,126}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "capture_id": {"type": "string", "format": "uuid"},
    "producer_client_id": {"type": "string", "format": "uuid"},
    "capture_method": {"type": "string", "minLength": 1, "maxLength": 128},
    "received_at": {"type": "string", "format": "date-time"}
  }
}
