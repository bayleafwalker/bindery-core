{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bindery.dev/contracts/externalruntime/v1/public-session.schema.json",
  "title": "Bindery external-runtime public match session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "execution_id", "created_by_account_id", "created_at", "phase", "compatibility", "participant_policy", "enrollments", "capture_policy", "public_data_notice_version"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "execution_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "placement_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "created_by_account_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "enum": ["created", "admitting", "ready", "running", "ended", "failed", "expired", "published"]},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "participant_policy": {"$ref": "#/$defs/participantPolicy"},
    "capture_policy": {"$ref": "#/$defs/capturePolicy"},
    "placement": {"$ref": "#/$defs/publicPlacement"},
    "enrollments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/publicEnrollment"}},
    "capture_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 36, "maxLength": 36}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "public_data_notice_version": {"type": "string", "minLength": 1, "maxLength": 32}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["game_family", "game_version", "game_hash", "adapter_id", "adapter_version", "mod_id", "mod_hash", "map_id", "map_hash"],
      "properties": {
        "game_family": {"type": "string", "minLength": 1, "maxLength": 64},
        "game_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "game_hash": {"$ref": "#/$defs/hash"},
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "mod_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "mod_hash": {"$ref": "#/$defs/hash"},
        "map_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "map_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "participantPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["required_players", "maximum_players", "maximum_observers"],
      "properties": {
        "required_players": {"type": "integer", "minimum": 2, "maximum": 8},
        "maximum_players": {"type": "integer", "minimum": 2, "maximum": 8},
        "maximum_observers": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "capturePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_events", "post_match_dump", "observer_preferred"],
      "properties": {"semantic_events": {"type": "boolean"}, "post_match_dump": {"type": "boolean"}, "observer_preferred": {"type": "boolean"}}
    },
    "publicPlacement": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "placement_id", "session_id", "region", "relay_provider_id", "relay_allocation_id", "relay_endpoint", "policy_version", "allocator", "created_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "placement_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "session_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "region": {"type": "string", "minLength": 1, "maxLength": 64},
        "relay_provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "relay_allocation_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "relay_endpoint": {"type": "string", "minLength": 3, "maxLength": 256},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "decision_summary": {"type": "string", "maxLength": 2048},
        "allocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "repository", "revision", "config_digest"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1, "maxLength": 128},
            "repository": {"type": "string", "minLength": 1, "maxLength": 512},
            "revision": {"type": "string", "minLength": 1, "maxLength": 128},
            "config_digest": {"$ref": "#/$defs/hash"}
          }
        },
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "publicEnrollment": {
      "type": "object", "additionalProperties": false,
      "required": ["client_id", "account_id", "client_class", "phase", "adapter_id", "adapter_version", "enrolled_at"],
      "properties": {
        "client_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "account_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "client_class": {"type": "string", "enum": ["player", "observer"]},
        "phase": {"type": "string", "enum": ["issued", "registered", "ready", "active", "departed", "lost", "expired"]},
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "enrolled_at": {"type": "string", "format": "date-time"},
        "departed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "from", "to", "occurred_at", "source", "reason"],
      "properties": {
        "transition_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "from": {"type": ["string", "null"]},
        "to": {"type": "string", "minLength": 1, "maxLength": 32},
        "occurred_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
