{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bindery.dev/contracts/externalruntime/v1/evidence-set.schema.json",
  "title": "Bindery reconciled evidence set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_set_id", "execution_id", "observations", "reconciliation", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_set_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "format": "uuid"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observer_id", "execution_id", "stream_id", "event_count", "source"],
        "properties": {
          "observer_id": {"type": "string", "format": "uuid"},
          "execution_id": {"type": "string", "format": "uuid"},
          "stream_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "event_count": {"type": "integer", "minimum": 0},
          "ordered_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Identity of one producer's stream. It covers who produced the stream, so two producers never share one."
          },
          "observed_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of what the stream witnessed, in order, excluding who observed it and when it was received. ordered-hash reconciliation compares this when every observation carries one, ordered_hash when none does, and refuses a mix."
          },
          "interval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first_received_at", "last_received_at"],
            "description": "What part of the execution the stream covers, so that observers who watched different intervals are distinguishable from observers who disagree about one. Game ticks are present only where the runtime has them. Absent for a stream with no observations.",
            "properties": {
              "first_game_tick": {"type": "integer", "minimum": 0},
              "last_game_tick": {"type": "integer", "minimum": 0},
              "first_received_at": {"type": "string", "format": "date-time"},
              "last_received_at": {"type": "string", "format": "date-time"}
            }
          },
          "source": {
            "type": "string",
            "enum": ["client-reported", "broker-derived"],
            "description": "Who counted. A summary the producer supplied is a claim about itself; one the broker computed from persisted observations is not. The field is part of the evidence set's content-derived identity, because an evidence set that cannot say which it holds cannot support a claim of independence."
          }
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "outcome", "compared_observers"],
      "properties": {
        "method": {"type": "string", "enum": ["exact-count", "ordered-hash", "record", "semantic-equivalence", "quorum", "domain-specific"]},
        "outcome": {"type": "string", "enum": ["consistent", "inconsistent", "uncompared"], "description": "uncompared is the outcome of a record, which compares nothing."},
        "compared_observers": {"type": "integer", "minimum": 0, "description": "At least 2 for a cross-check method; 0 for a record."},
        "distinct_counts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "distinct_hashes": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
