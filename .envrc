# bindery-core work is served by the Vuoro work adapter, same as sprintctl's.
# Added 2026-08-25: the four preconditions the kctl authority check needs were
# all present on this machine but none of them were wired here, so the check
# reported them as absent. Three of the four live in this file; the fourth is
# the vuoro_client module, which is installed inside kctl's own tool
# environment -- run the check through the `kctl` CLI (or that interpreter),
# not the system python3, which cannot see it.

export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
export SPRINTCTL_DB="$PWD/.sprintctl/sprintctl.db"
unset SPRINTCTL_URL

# The repository identity comes from .sprintctl/backend.json (gitignored), so
# KCTL_SPRINTCTL_REPO_ID is deliberately NOT exported: with the marker present
# sprintctl reports `source=marker`, and an env var that shadows the marker is
# how one shell ends up scoped to a different repo than the directory it is in.
export KCTL_DB="$PWD/.kctl/kctl.db"
export KCTL_PROJECT="bindery-core"
export AUDITCTL_DB="$PWD/.auditctl/auditctl.db"
export AUDITCTL_ARTIFACTS_ROOT="/projects/dev"

# Host-specific overrides (e.g. the devbox-agent profile) belong in
# .envrc.local, which is gitignored and sourced last so it can override
# anything above.
source_env_if_exists .envrc.local
