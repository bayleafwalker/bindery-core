# Non-secret local defaults. Credentials are supplied by the credential broker
# or an operator environment and are never committed here.
export BINDERY_EXTERNAL_RUNTIME_ADDR="127.0.0.1:8080"
export BINDERY_RESEARCH_MODE="external-runtime"
export BINDERY_WORKER_NETWORK="none"
export BINDERY_WORKER_MODEL="local3090/worker-fast"

