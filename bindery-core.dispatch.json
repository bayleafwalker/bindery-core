{
  "schema_version": 1,
  "repo_id": "bindery-core",
  "authority_repo_uuid": "2f6f7f1c-0f0c-4dcb-90e7-0f1a4b7f89f2",
  "adoption_level": "dispatchable",
  "routing": {
    "default_harness": "codex",
    "default_model_alias": "gpt-5.6-luna",
    "action_classes": {
      "plan": {"enabled": true, "model_alias": "gpt-5.6-luna"},
      "build": {"enabled": true, "model_alias": "local3090/worker-fast", "review_required": true},
      "review": {"enabled": true, "model_alias": "gpt-5.6-luna"},
      "verify": {"enabled": true, "model_alias": "gpt-5.6-luna", "review_required": true},
      "release": {"enabled": true, "model_alias": "gpt-5.6-luna"}
    }
  },
  "skills": {
    "template_root": "/projects/dev/agentops/templates/dispatch/skills",
    "selected": [
      "dispatch-plan",
      "dispatch-build",
      "dispatch-review",
      "code-change-verification",
      "sprint-maintenance",
      "task-pickup",
      "plan-review",
      "pr-handoff-summary",
      "verify-state-protocols",
      "reconcile-project-contracts"
    ],
    "overlays": [
      ".agents/overlays/bindery.boundaries.md",
      ".agents/overlays/bindery.hybrid-worker.md"
    ]
  },
  "scope": {
    "allowed_path_roots": ["cmd/", "contracts/", "internal/", "pkg/", "charts/", "docs/", "verification/", ".agents/", ".github/", "go.mod", "README.md"],
    "out_of_scope": ["credentials and plaintext secrets", "schemas, migrations, and deployment manifests", "security policy, release metadata, and rollout mutation"]
  },
  "risk_surfaces": [
    {
      "id": "external-runtime-state",
      "paths": ["internal/externalruntime/**", "contracts/externalruntime/**", "verification/contexts/**"],
      "skills": ["verify-state-protocols"],
      "context_ids": ["bindery.external-runtime.w0.contract-redaction"],
      "default_depth": 2,
      "required_on_change": true
    },
    {
      "id": "relay-authentication-and-placement",
      "paths": ["internal/relay/**", "pkg/relayv1/**", "contracts/externalruntime/v1/relay.md"],
      "skills": ["verify-state-protocols"],
      "context_ids": ["bindery.external-runtime.w1.relay-placement"],
      "default_depth": 2,
      "required_on_change": true
    }
  ],
  "hybrid": {
    "enabled": true,
    "worker_routes": ["bindery_external_runtime_w0"],
    "commands": {
      "bindery.unit.race": "go test -race ./...",
      "bindery.unit.vet": "go vet ./...",
      "bindery.chart.lint": "helm lint charts/bindery-external-runtime",
      "bindery.redaction": "go run ./cmd/bindery-redaction-scan",
      "bindery.verification.artifacts": "python /projects/dev/agentops/templates/dispatch/scripts/validate_verification_artifacts.py --root ."
    },
    "protected_paths": ["contracts/**", "migrations/**", "charts/**", ".github/**", ".agents/**", "credentials/**", "verification/contexts/**"],
    "worktree_root": "/tmp/agentworker/worktrees",
    "max_timeout_seconds": 1800,
    "max_cost_usd": 30.0,
    "soft_token_ceiling": 128000,
    "hard_token_ceiling": 256000,
    "notes": [
      "The worker is eligible only for W0 mechanical implementation beneath frozen coordinator-authored interfaces and tests.",
      "The worker has no Git, Sprintctl, credential, deployment, release, security-policy, or acceptance authority.",
      "Receipts remain qualification_eligible=false and require Luna review plus human acceptance.",
      "Local worker token ceilings are operational runaway bounds, not provider billing limits: W0 uses 128000 soft and 256000 hard tokens while the route remains unqualified."
    ]
  },
  "gates": ["bindery.contracts", "bindery.unit", "bindery.relay", "bindery.integration", "bindery.redaction", "bindery.helm"],
  "verification": {
    "command_families": ["unit", "integration", "lint", "docs", "full-suite"],
    "targeted_first": true,
    "commands": ["go test -race ./...", "go vet ./...", "helm lint charts/bindery-external-runtime", "go run ./cmd/bindery-redaction-scan", "python /projects/dev/agentops/templates/dispatch/scripts/validate_verification_artifacts.py --root ."]
  },
  "hooks": {"level": "verification", "publishers": ["git", "workspace-cost", "dispatcher-gate"]}
}
