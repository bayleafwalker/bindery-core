{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bindery.dev/schemas/external-runtime/telemetry-event/1.0.0",
  "title": "Bindery public telemetry event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "event_id",
    "session_id",
    "capture_id",
    "producer_client_id",
    "producer_class",
    "capture_method",
    "adapter",
    "sequence",
    "received_at",
    "event_type",
    "payload"
  ],
  "properties": {
    "schema": {"const": "bindery.telemetry.event"},
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "session_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "capture_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "producer_client_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "producer_class": {"type": "string", "enum": ["player", "observer", "relay", "normalizer"]},
    "capture_method": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "sequence": {"type": "integer", "minimum": 0},
    "game_tick": {"type": ["integer", "null"], "minimum": 0},
    "producer_time": {"type": ["string", "null"], "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "payload_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "payload": {"type": "object"},
    "raw_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "byte_offset": {"type": "integer", "minimum": 0},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizer_id", "normalizer_version", "source_event_ids"],
      "properties": {
        "normalizer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "normalizer_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 16, "maxLength": 64}
        }
      }
    }
  }
}

